{
  "name": "feinipedia",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "tsx watch server/index.ts",
    "build": "vue-tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "start": "node dist-server/server/index.js",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "dexie": "^4.2.1",
    "express": "^5.1.0",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.1.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "fake-indexeddb": "^6.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.6",
    "vite-plugin-pwa": "^1.0.1",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.0"
  }
}

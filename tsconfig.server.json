{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist-server",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["api/**/*.ts", "server/**/*.ts", "src/domain/schemas.ts"],
  "exclude": ["api/**/*.test.ts", "server/**/*.test.ts"]
}
